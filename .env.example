# ---- App ----
APP_ENV=development
PORT=8080
PUBLIC_WEB_URL=http://localhost:5173

# ---- Database ----
POSTGRES_DB=textile
POSTGRES_USER=textile
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgres://textile:change-me-strong-db-password@localhost:5432/textile?sslmode=disable

# ---- Auth ----
# openssl rand -base64 48
JWT_SECRET=dev-only-change-me-please-use-a-48-byte-random-secret
ACCESS_TTL=15m
REFRESH_TTL=720h
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- HTTP ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTO_MIGRATE=true
LOGIN_RATE_PER_MIN=8

# ---- AI assistant (optional, OpenAI-compatible) ----
# Works offline without a key (local intent engine + deterministic photo
# analyser). With a key, chat and vision are routed through OpenRouter.
# AI_ENABLED=true
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_VISION_MODEL=google/gemini-2.0-flash-exp:free
# AI_TIMEOUT=45s

# ---- Seed admin (optional) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!Strong
